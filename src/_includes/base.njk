      "url": "https://www.leanrise-coaching.com",
      "image": "https://www.leanrise-coaching.com/assets/images/logo-leanrise-light.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bordeaux",
        "addressRegion": "Nouvelle-Aquitaine",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 44.8378,
        "longitude": -0.5792
      },
      "areaServed": [
        { "@type": "City", "name": "Bordeaux" },
        { "@type": "Country", "name": "France" }
      ],
      "founder": {
        "@type": "Person",
        "name": "Gianni Di Guida",
        "jobTitle": "Coach fitness et nutrition personnel"
      },
      "serviceType": [
        "Coaching fitness personnel",
        "Coaching nutrition",
        "Coach sportif en ligne",
        "Perte de poids",
        "Prise de masse musculaire"
      ],
      "availableLanguage": "French",
      "priceRange": "$$"
    }
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script>history.scrollRestoration = 'manual'; window.scrollTo(0, 0);</script>
    <link rel="stylesheet" href="/assets/css/main.css" />
  </head>
  <body>
    {{ content | safe }}
  </body>
</html>
