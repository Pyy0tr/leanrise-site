---
layout: base.njk
title: Transforme ton corps. Sans sacrifier ta vie.
---

<!-- ========== NAV ========== -->
<nav class="nav">
  <a href="#" class="nav__logo">
    <img src="/assets/images/logo-leanrise-light.png" alt="LEANRISE" class="nav__logo-img">
  </a>
  <div class="nav__links">
    <a href="#resultats" class="nav__link">Résultats</a>
    <a href="#temoignages" class="nav__link">Témoignages</a>
    <a href="https://calendly.com/giannidiguida-coaching/30min" class="nav__cta" target="_blank" rel="noopener">Réserver</a>
  </div>
</nav>

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="hero__bg">
    <!-- Photo de Gianni ici -->
  </div>
  <div class="hero__content">
    <span class="hero__brand">LEANRISE</span>
    <h1 class="hero__title">Transforme ton corps.<br><em>Sans sacrifier ta vie.</em></h1>
    <p class="hero__sub">Coaching 1-1 sur-mesure pour hommes actifs qui veulent des résultats durables.</p>
    <a href="https://calendly.com/giannidiguida-coaching/30min" class="btn btn--primary" target="_blank" rel="noopener">
      Réserver mon appel découverte
    </a>
    <p class="hero__note">Gratuit · 30 minutes · Sans engagement</p>
  </div>
</section>

<!-- ========== SOCIAL PROOF BAR ========== -->
<section class="stats">
  <div class="stats__item" data-reveal>
    <span class="stats__number" data-count="100" data-count-prefix="+">+100</span>
    <span class="stats__label">clients transformés</span>
  </div>
  <div class="stats__item" data-reveal data-delay="2">
    <span class="stats__number">3–6</span>
    <span class="stats__label">mois d'accompagnement</span>
  </div>
  <div class="stats__item" data-reveal data-delay="4">
    <span class="stats__number" data-count="100" data-count-suffix="%">100%</span>
    <span class="stats__label">personnalisé</span>
  </div>
</section>

<!-- ========== VIDÉO INTRO ========== -->
<section class="section video-intro">
  <div class="section__inner">
    <h2 class="section__title" data-reveal>La méthode qui s'adapte à ta vie.<br><em>Pas l'inverse.</em></h2>
    <div class="video-intro__frame" data-reveal data-delay="1">
      <iframe
        src="https://www.youtube.com/embed/xSEW0gAr-Kk"
        title="La méthode qui s'adapte à ta vie. Pas l'inverse."
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen>
      </iframe>
    </div>
  </div>
</section>

<!-- ========== PROBLÈME ========== -->
<section class="section problem">
  <div class="section__inner">
    <span class="section__tag" data-reveal>Le problème</span>
    <h2 class="section__title" data-reveal data-delay="1">Tu travailles dur.<br>Ton corps ne suit pas.</h2>
    <div class="problem__list">
      <p class="problem__item" data-reveal data-delay="2">Tu manges mal parce que tu n'as pas le temps de faire autrement.</p>
      <p class="problem__item" data-reveal data-delay="3">Tu t'es inscrit à la salle. Plusieurs fois. Sans vraiment tenir.</p>
      <p class="problem__item" data-reveal data-delay="4">Tu vois des résultats sur les réseaux — mais rien ne colle à ta réalité.</p>
      <p class="problem__item" data-reveal data-delay="5">Tu sais que quelque chose doit changer. Tu ne sais pas par où commencer.</p>
    </div>
  </div>
</section>

<!-- ========== MÉTHODE ========== -->
<section class="section method">
  <div class="section__inner">
    <span class="section__tag" data-reveal>La méthode</span>
    <h2 class="section__title" data-reveal data-delay="1">Un plan construit pour ta vie.<br><em>Pas pour une vie idéale.</em></h2>
    <div class="method__steps">
      <div class="method__step" data-reveal data-delay="2">
        <span class="method__number">01</span>
        <div>
          <h3 class="method__step-title">Diagnostic complet</h3>
          <p class="method__step-text">Un appel de 30 à 45 minutes pour comprendre ton point de départ, tes contraintes et tes objectifs réels.</p>
        </div>
      </div>
      <div class="method__step" data-reveal data-delay="3">
        <span class="method__number">02</span>
        <div>
          <h3 class="method__step-title">Plan 100% personnalisé</h3>
          <p class="method__step-text">Nutrition et entraînement adaptés à ton emploi du temps, tes goûts, ton niveau.</p>
        </div>
      </div>
      <div class="method__step" data-reveal data-delay="4">
        <span class="method__number">03</span>
        <div>
          <h3 class="method__step-title">Suivi quotidien</h3>
          <p class="method__step-text">Tu n'es jamais seul. Ajustements hebdomadaires en fonction de tes résultats réels.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== TRANSFORMATIONS ========== -->
<section class="section transformations" id="resultats">
  <div class="section__inner">
    <span class="section__tag" data-reveal>Résultats</span>
    <h2 class="section__title" data-reveal data-delay="1">Ils ont changé.<br><em>Pour de vrai.</em></h2>
  </div>

  <div class="gallery" data-reveal data-delay="2">
    <div class="gallery__stage" aria-label="Carrousel de transformations">
      {% for item in transformations.photos %}
      <div class="gallery__item">
        <img src="{{ item.photo }}" alt="Transformation {{ loop.index }}"
             loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">
      </div>
      {% endfor %}
    </div>
    <div class="gallery__dots" role="tablist" aria-label="Navigation"></div>
  </div>
</section>

<!-- ========== LIGHTBOX ========== -->
<div class="gallery__lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
  <button class="gallery__lightbox-close" aria-label="Fermer">&#x2715;</button>
  <img class="gallery__lightbox-img" src="" alt="">
</div>

<!-- ========== GIANNI ========== -->
<section class="section coach" id="coach">
  <div class="section__inner">
    <div class="coach__photo" data-reveal>
      <img src="/assets/images/photos/gianni.webp" alt="Gianni Di Guida — coach fitness" loading="lazy" decoding="async">
    </div>
    <span class="section__tag" data-reveal data-delay="1">Le coach</span>
    <h2 class="section__title" data-reveal data-delay="2">Gianni Di Guida</h2>
    <p class="coach__bio" data-reveal data-delay="3">Coach fitness en ligne spécialisé dans la transformation des hommes actifs. Mon approche : zéro régime, zéro programme générique. Uniquement ce qui fonctionne pour toi, dans ta vie.</p>
    <a href="https://www.instagram.com/gianni.diguida/" target="_blank" rel="noopener" class="instagram-card" data-reveal data-delay="4">
      <div class="instagram-card__left">
        <div class="instagram-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
          </svg>
        </div>
        <div class="instagram-card__info">
          <span class="instagram-card__handle">@gianni.diguida</span>
          <span class="instagram-card__followers">20 000 abonnés</span>
        </div>
      </div>
      <span class="instagram-card__btn">Suivre</span>
    </a>
  </div>
</section>

<!-- ========== TÉMOIGNAGES ========== -->
<section class="section testimonials" id="temoignages">
  <div class="section__inner">
    <span class="section__tag" data-reveal>Témoignages</span>
    <h2 class="section__title" data-reveal data-delay="1">Ils te le disent<br><em>eux-mêmes.</em></h2>

    <script>window.__VIDEOS__ = {{ testimonials.videos | youtubeIds | json | safe }};</script>
    <div class="vidgallery" data-reveal data-delay="2" aria-label="Carrousel de témoignages">
      <div class="vidgallery__stage">
        <button class="vidgallery__nav vidgallery__nav--prev" aria-label="Témoignage précédent">&#8249;</button>
        <div class="vidgallery__screen" id="vidgalleryScreen"></div>
        <button class="vidgallery__nav vidgallery__nav--next" aria-label="Témoignage suivant">&#8250;</button>
        <span class="vidgallery__count" id="vidgalleryCount"></span>
      </div>
      <div class="vidgallery__thumbs" id="vidgalleryThumbs" role="tablist" aria-label="Sélectionner un témoignage"></div>
    </div>
  </div>
</section>

<!-- ========== OFFRE ========== -->
<section class="section offer">
  <div class="section__inner">
    <span class="section__tag" data-reveal>L'accompagnement</span>
    <h2 class="section__title" data-reveal data-delay="1">Un suivi sur-mesure.<br><em>De A à Z.</em></h2>
    <ul class="offer__list">
      <li class="offer__item" data-reveal data-delay="2">Appel découverte diagnostique (30–45 min)</li>
      <li class="offer__item" data-reveal data-delay="3">Plan nutrition personnalisé</li>
      <li class="offer__item" data-reveal data-delay="4">Programme d'entraînement adapté</li>
      <li class="offer__item" data-reveal data-delay="5">Suivi quotidien par message</li>
      <li class="offer__item" data-reveal data-delay="6">Ajustements hebdomadaires</li>
      <li class="offer__item" data-reveal data-delay="6">Accompagnement de 3 à 6 mois</li>
    </ul>
    <p class="offer__note" data-reveal>L'investissement est adapté à chaque profil selon ses objectifs.</p>
  </div>
</section>

<!-- ========== CTA FINAL ========== -->
<section class="section cta-final">
  <div class="section__inner">
    <h2 class="cta-final__title" data-reveal>Prêt à changer ?</h2>
    <p class="cta-final__sub" data-reveal data-delay="1">Réserve ton appel découverte. On échange sur ta situation, tes objectifs, et on voit ensemble si on peut travailler ensemble.</p>
    <a href="https://calendly.com/giannidiguida-coaching/30min" class="btn btn--primary" target="_blank" rel="noopener" data-reveal data-delay="2">
      Réserver mon appel découverte
    </a>
    <p class="cta-final__note" data-reveal data-delay="3">Gratuit · 30 minutes · Sans engagement</p>
  </div>
</section>

<script src="/assets/js/animations.js?v={{ build.version }}" defer></script>
<script src="/assets/js/gallery.js?v={{ build.version }}" defer></script>
<script src="/assets/js/vidgallery.js?v={{ build.version }}" defer></script>
