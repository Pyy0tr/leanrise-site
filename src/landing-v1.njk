    <div class="method__steps">
      <div class="method__step" data-reveal data-delay="2">
        <span class="method__number">01</span>
        <div>
          <h3 class="method__step-title">Diagnostic complet</h3>
          <p class="method__step-text">Un appel de 30 à 45 minutes pour comprendre ton point de départ, tes contraintes et tes objectifs réels.</p>
        </div>
      </div>
      <div class="method__step" data-reveal data-delay="3">
        <span class="method__number">02</span>
        <div>
          <h3 class="method__step-title">Plan 100% personnalisé</h3>
          <p class="method__step-text">Nutrition et entraînement adaptés à ton emploi du temps, tes goûts, ton niveau.</p>
        </div>
      </div>
      <div class="method__step" data-reveal data-delay="4">
        <span class="method__number">03</span>
        <div>
          <h3 class="method__step-title">Suivi quotidien</h3>
          <p class="method__step-text">Tu n'es jamais seul. Ajustements hebdomadaires en fonction de tes résultats réels.</p>
        </div>
      </div>
    </div>
  </div>
</section>

